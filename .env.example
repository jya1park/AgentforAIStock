# Copy to .env and fill values. .env is gitignored.

# OpenAI — required for all agent calls (stock-analyst, red-team, etc.)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Naver Search API — required for KR-ticker news (.KS/.KQ)
# https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Finnhub — supplemental US-ticker news (Reuters/Bloomberg via aggregator)
# Free tier: 60 calls/min. https://finnhub.io (sign up → API Key)
# If empty, US news falls back to yfinance only.
FINNHUB_API_KEY=
