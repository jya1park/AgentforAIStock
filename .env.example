# Copy to .env and fill values. .env is gitignored.

# OpenAI — required for all agent calls (stock-analyst, red-team, etc.)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# OpenAI — used by call_agent (stock-analyst, etc.)
OPENAI_API_KEY=

# Naver Search API — required for KR-ticker news (.KS/.KQ)
# https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# NewsAPI.org — supplemental US-ticker news from tier-1 outlets
# (Bloomberg, Reuters, FT, WSJ, CNBC, MarketWatch, Barron's, Seeking Alpha).
# Free tier: 100 calls/day. https://newsapi.org/register
# If empty, US news falls back to yfinance only.
NEWSAPI_KEY=
